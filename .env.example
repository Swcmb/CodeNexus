# codenexus 环境配置示例
# 复制此文件为 .env 并修改相应的值

# 数据库配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# AI模型配置
AI_MODEL_NAME=deepseek-coder
AI_API_KEY=your_api_key_here
AI_API_BASE=https://api.deepseek.com
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.1
AI_TIMEOUT=30

# 解析器配置
PARSER_MAX_FILE_SIZE=10485760  # 10MB
PARSER_TIMEOUT=60
PARSER_WORKERS=4

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=false
SERVER_RELOAD=false
SERVER_WORKERS=1